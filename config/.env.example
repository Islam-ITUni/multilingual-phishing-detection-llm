# Copy to .env (in the project root) and fill in. NEVER commit the real .env file.

# --- Application ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SALT=change-me
RATE_LIMIT_PER_MINUTE=30

# --- Database ---
DATABASE_URL=postgresql+psycopg://phish_user:change-me@localhost:5432/phishing_db
# For tests: sqlite:///./test.db

# --- Detection pipeline ---
FAST_MODEL_PATH=./models/distilbert-multilingual-phishing
LLM_BACKEND=local
LLM_MODEL_NAME=google/gemma-2-9b-it
LLM_ENDPOINT=http://localhost:11434
LOW_CONFIDENCE_THRESHOLD=0.80

# --- Optional benchmark only (non-sensitive/synthetic data!) ---
OPENAI_API_KEY=
URL_BLACKLIST_FEED=
